{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker that owns onduu.ke, or a local `wrangler deploy`
  // silently creates a second Worker instead of updating production.
  "name": "onduudotke",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite plugin points `assets.directory` at the client build itself; only
  // the binding is declared here, since worker/index.ts reads env.ASSETS.
  "assets": {
    "binding": "ASSETS"
  },
  // Backs the /_vinext/image optimisation endpoint.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
