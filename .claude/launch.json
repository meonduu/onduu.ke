{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "onduu-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "onduu-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        "dist/server/wrangler.json",
        "--port",
        "3000",
        "--inspector-port",
        "0"
      ],
      "port": 3000
    }
  ]
}
