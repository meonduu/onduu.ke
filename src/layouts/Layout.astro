---
// Base document. Replicates the vinext build's metadata values exactly — but
// places them in <head>, where they belong. (vinext emitted title/meta inside
// a hidden div at the end of <body>; parity is on values, not position.)
//
// Parity quirks preserved deliberately (see docs/specs/astro-migration.md):
// the homepage, /check and the 404 page ship no canonical and no Open Graph
// tags, exactly like the baseline. Fixing that is a Phase 1 content decision.
import { SITE_URL } from "../data/route-policy";
import "../styles/globals.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Omit to skip canonical + Open Graph entirely. */
  canonical?: string;
  author?: string;
  noindex?: boolean;
}
const { title, description, canonical, author, noindex = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F1E8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      canonical && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:site_name" content="Onduu" />
          <meta property="og:type" content="website" />
          <meta property="og:image" content={`${SITE_URL}/og-card.png`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Onduu — Digital Readiness for Kenyan businesses" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // First-party enquiry attribution (see components/attribution.ts).
      // A plain script, not a React island: it must not cost the reader a
      // framework download on pages that have no other interactivity.
      import { capture } from "../components/attribution";
      capture();
    </script>
  </body>
</html>
