import Layout from "../layouts/Layout.astro";
import { DomainsPage } from "../components/domains-page";
import { DomainsForm } from "../components/domains-form";
---

<Layout
  title="Kenyan Domain Search: Registrar and Expiry | Onduu"
  description="Search any .ke or .co.ke domain alongside its twin: owning one without the other leaves the door open for someone else. Registrar and expiry included."
  canonical="https://onduu.ke/kedomains"
>
  <DomainsPage>
    <DomainsForm client:load />
  </DomainsPage>
</Layout>
