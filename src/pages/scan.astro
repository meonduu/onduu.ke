// LAUNCHED 18 August 2026: SCAN_ENABLED is set as a production Worker secret
// (survives deploys), migrations 0004/0005 are applied, and the page is
// linked from the footer and sitemap. The flag remains the kill switch —
// deleting the secret returns /api/scan to 404 instantly (see
// docs/runbooks/scan-launch.md).
import Layout from "../layouts/Layout.astro";
import { ScanPage } from "../components/scan-page";
import { ScanForm } from "../components/scan-form";
import { TURNSTILE_SITE_KEY } from "../data/route-policy";
